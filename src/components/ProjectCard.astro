---
import { ui } from '../data/site';
import type { Lang } from '../data/site';
import type { Project } from '../data/projects';
import { withBase } from '../lib/path';

interface Props {
  project: Project;
  lang: Lang;
  eager?: boolean;
}

const { project, lang, eager = false } = Astro.props;
const t = ui[lang];
const href = withBase(`/${lang}/work/${project.slug}/`);
---

<a href={href} class="card reveal">
  <div class="thumb">
    <img
      src={withBase(project.cover)}
      alt={project.coverAlt}
      width="800"
      height="500"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="bg-bg px-3 py-3">
    <div class="flex items-baseline justify-between gap-2">
      <span class="text-[13.5px] font-semibold tracking-[-0.015em]">{project.name}</span>
      <span class="text-[11px] tabular-nums text-muted">{project.year}</span>
    </div>
    <p class="mb-2 mt-0.5 text-[12px] leading-snug text-muted">{project.tagline[lang]}</p>
    <div class="flex flex-wrap items-center gap-1">
      <span class="mr-0.5 inline-flex items-center gap-1 rounded-full border border-line px-1.5 py-[1px] text-[10.5px] text-muted">
        <span
          class:list={[
            'size-1 rounded-full',
            project.status === 'live' ? 'bg-[#22c55e]' : 'bg-[#eab308]',
          ]}
          aria-hidden="true"
        />
        {project.status === 'live' ? t.live : t.soon}
      </span>
      {project.stack.slice(0, 3).map((item) => <span class="tag">{item}</span>)}
    </div>
  </div>
</a>
