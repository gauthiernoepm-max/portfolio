---
import { withBase } from '../lib/path';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gauthier Combes</title>
    <link rel="canonical" href={withBase('/fr/')} />
    <meta http-equiv="refresh" content={`0; url=${withBase('/fr/')}`} />
    <script is:inline define:vars={{ target: withBase('/fr/') }}>
      const preferred = navigator.language?.toLowerCase().startsWith('fr') ? '/fr/' : '/en/';
      window.location.replace(target.replace(/\/fr\/$/, preferred));
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        display: grid;
        min-height: 100vh;
        place-items: center;
        color: #09090b;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <p><a href={withBase('/fr/')}>Gauthier Combes — portfolio</a></p>
  </body>
</html>
